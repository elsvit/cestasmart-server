# Local API port. Tareitas uses 3000 on the same machine.
PORT=3001
NODE_ENV=development

# Separate database on the shared Hetzner PostgreSQL server.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/cestasmart

# Optional. When set, every route except /api/health requires header x-api-key.
# API_KEY=

# Hetzner Object Storage (S3-compatible).
# Use the same bucket as Tareitas if you want. This API always writes keys
# under the cestasmart/ prefix (cestasmart/dish-images/, cestasmart/generic-product-images/).
# Leave unset in local development: files are stored in ./uploads/.
# S3_ENDPOINT=https://hel1.your-objectstorage.com
# S3_REGION=hel1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_CDN_BASE_URL=https://cdn.cestasmart.com
# S3_PRESIGN_EXPIRY_SECONDS=900
