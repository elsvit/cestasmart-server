// CestaSmart tables, stored in the cestasmart PostgreSQL database.
// Column names match the snake_case payloads the admin sends.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MercadonaCategory {
  id          String   @id
  name        String
  name_en     String?
  parent_id   String?
  order_index Int      @default(0)
  is_not_food Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  products MercadonaProduct[]
  links    MercadonaCategoryProduct[]

  @@index([parent_id])
  @@map("mercadona_categories")
}

model MercadonaProduct {
  id                      String   @id
  name                    String
  description             String?
  brand                   String?
  quantity                Decimal? @db.Decimal(10, 2)
  packaging               String?
  size_format             String?
  size                    Decimal? @db.Decimal(10, 2)
  ud_size_format          String?
  ud_size                 Decimal? @db.Decimal(10, 2)
  image                   String?
  thumbnail               String?
  images                  String[]
  product_link            String?
  price                   Decimal? @db.Decimal(10, 2)
  price_per_unit          Decimal? @db.Decimal(10, 2)
  seller                  String?
  protein                 Decimal? @db.Decimal(10, 2)
  fat                     Decimal? @db.Decimal(10, 2)
  carbohydrates           Decimal? @db.Decimal(10, 2)
  calories                Decimal? @db.Decimal(10, 2)
  calories_per_100g       Decimal? @db.Decimal(10, 2)
  salt                    Decimal? @db.Decimal(10, 2)
  sugar                   Decimal? @db.Decimal(10, 2)
  fiber                   Decimal? @db.Decimal(10, 2)
  saturated_fat           Decimal? @db.Decimal(10, 2)
  monounsaturated_fat     Decimal? @db.Decimal(10, 2)
  polyunsaturated_fat     Decimal? @db.Decimal(10, 2)
  cholesterol             Decimal? @db.Decimal(10, 2)
  sodium                  Decimal? @db.Decimal(10, 2)
  vitamins                String[]
  minerals                String[]
  nutri_score             String?
  total_dissolved_solids  Decimal? @db.Decimal(10, 2)
  allergens               String[]
  storage_conditions      String?
  date                    String?
  is_disabled             Boolean? @default(false)
  category_id             String?
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  category MercadonaCategory?         @relation(fields: [category_id], references: [id], onDelete: SetNull)
  links    MercadonaCategoryProduct[]

  @@index([category_id])
  @@map("mercadona_products")
}

model MercadonaCategoryProduct {
  category_id String
  product_id  String

  category MercadonaCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)
  product  MercadonaProduct  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([category_id, product_id])
  @@map("mercadona_category_products")
}

